# The golden protocol description is compared byte-for-byte with generated JSON.
shared/src/test/resources/web/records-v1.json text eol=lf
# Keep the supplied AAC-ELD distribution byte-for-byte with its pinned checksums.
site/play/vendor/aac-eld/aac-eld.js -text -whitespace
site/play/vendor/aac-eld/aac-eld-source.zip -text -whitespace
site/play/vendor/aac-eld/NOTICE -text -whitespace
site/play/vendor/aac-eld/MODIFICATIONS.txt -text -whitespace
# Preserve the reproducible generated JavaScript and the exact corresponding source patch.
site/play/vendor/libmedia/*.js text eol=lf -whitespace
scripts/avplayer/entry.js text eol=lf -whitespace
site/play/vendor/soxr/source/tiplay.patch text eol=lf -whitespace
site/play/vendor/soxr/source/wasm.patch text eol=lf -whitespace
# Preserve unmodified upstream legal notices, including their original whitespace.
site/play/vendor/soundtouch/COPYING.LGPL -text -whitespace
site/play/vendor/wasm-runtime/llvm/*.TXT -text -whitespace
site/play/vendor/wasm-runtime/wasi-libc/*.txt -text -whitespace
# Preserve generated native libsoxr sources byte-for-byte with the same archive/patch.
shared/src/main/jni/soxr/*.c text eol=lf -whitespace linguist-vendored=true
shared/src/main/jni/soxr/*.h text eol=lf -whitespace linguist-vendored=true
shared/src/main/jni/soxr/COPYING.LGPL text eol=lf -whitespace
shared/src/main/jni/soxr/LICENCE text eol=lf -whitespace
# Retain exact pinned SRP distribution and WebRTC binary license notices.
site/play/vendor/tssrp6a/* -text -whitespace linguist-vendored=true
shared/src/main/assets/licenses/webrtc/* -text -whitespace linguist-vendored=true
