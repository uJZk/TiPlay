+void WebRtcVideoSendChannel::WebRtcVideoSendStream::SetTiPlaySourceRateEpoch(
+    std::shared_ptr<tiplay::SourceRateEpoch> epoch) {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  parameters_.config.rtp.tiplay_epoch = std::move(epoch);
+  if (stream_) RecreateWebRtcStream();
