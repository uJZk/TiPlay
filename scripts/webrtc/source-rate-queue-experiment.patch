+WebRtcVideoSendChannel::BeginTiPlaySourceRateEpoch(uint32_t ssrc) {
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  auto stream = send_streams_.find(ssrc);
+  if (stream == send_streams_.end()) return nullptr;
+  auto transport =
+      call_->GetTransportControllerSend()->GetTiPlaySourceRateTransport();
+  if (!transport) return nullptr;
+  static std::atomic<uint64_t> next_epoch{1};
+  auto epoch = std::make_shared<tiplay::SourceRateEpoch>(
+      next_epoch.fetch_add(1, std::memory_order_relaxed), transport);
+  stream->second->SetTiPlaySourceRateEpoch(epoch);
+  return epoch;
+}
