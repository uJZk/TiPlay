+class SourceRateDiagnosticLogSink final : public LogSink {
+ public:
+  SourceRateDiagnosticLogSink() { LogMessage::AddLogToStream(this, LS_INFO); }
+  ~SourceRateDiagnosticLogSink() override { LogMessage::RemoveLogToStream(this); }
+  void OnLogMessage(const std::string& message) override {
+    if (message.find("TIPLAY_RTC_SOURCE_RATE ") == std::string::npos) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    messages_.push_back(message);
+  }
+  int Count(const std::string& token) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    int count = 0;
+    for (const auto& message : messages_)
+      if (message.find(token) != std::string::npos) ++count;
+    return count;
+  }
+ private:
+  std::mutex mutex_;
+  std::vector<std::string> messages_;
+};
+
+class SourceRateTransferObserver final : public TargetTransferRateObserver {
+ public:
+  void OnTargetTransferRate(TargetTransferRate) override { ++updates; }
+  void OnStartRateUpdate(DataRate) override { ++starts; }
+  int updates = 0;
+  int starts = 0;
+};
+
+TEST(RtpTransportControllerSendTest, SourceRateReportsControllerSkipOnceWithoutRateUpdates) {
+  test::RunLoop main_thread;
+  SourceRateDiagnosticLogSink log;
+  SourceRateTransferObserver observer;
+  RtpTransportControllerSend transport({.env = CreateTestEnvironment({
+      .field_trials = CreateTestFieldTrials("TiPlay-SourceRateVideo/Enabled/")})});
+  transport.RegisterTargetTransferRateObserver(&observer);
+  transport.OnNetworkAvailability(true);
+  transport.OnNetworkAvailability(false);
+  transport.OnNetworkAvailability(true);
+  EXPECT_GT(transport.SourceRateDiagnosticId(), 0u);
+  EXPECT_EQ(observer.starts, 0);
+  EXPECT_EQ(observer.updates, 0);
+  EXPECT_EQ(log.Count("controller_skipped"), 1);
+}
+
+TEST(RtpTransportControllerSendTest, SourceRateDoesNotMarkAdaptiveController) {
+  test::RunLoop main_thread;
