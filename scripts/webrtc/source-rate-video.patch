+void VideoStreamEncoder::SetSourceRateSending(
+    bool network_available, bool stream_active, uint64_t transport_id,
+    uint32_t ssrc) {
+  if (!env_.field_trials().IsEnabled("TiPlay-SourceRateVideo")) return;
+  if (!encoder_queue_->IsCurrent()) {
+    encoder_queue_->PostTask([this, network_available, stream_active, transport_id, ssrc] {
+      SetSourceRateSending(network_available, stream_active, transport_id, ssrc);
+    });
+    return;
+  }
+  RTC_DCHECK_RUN_ON(encoder_queue_.get());
+  if (source_rate_transport_id_ != transport_id || source_rate_ssrc_ != ssrc)
+    source_rate_gate_observed_ = 0;
+  source_rate_transport_id_ = transport_id;
+  source_rate_ssrc_ = ssrc;
+  source_rate_network_available_ = network_available;
+  source_rate_stream_active_ = stream_active;
+  const bool enabled = network_available && stream_active;
+  source_rate_sending_ = enabled;
+  for (int i = 0; i < send_codec_.numberOfSimulcastStreams; ++i)
+    frame_cadence_adapter_->UpdateLayerStatus(i, enabled);
+}
