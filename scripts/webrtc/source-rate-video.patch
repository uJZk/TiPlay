+TEST_F(VideoStreamEncoderTest, SourceRateDiagnosticGateTracksActualNetworkChecks) {
+  SourceRateDiagnosticLogSink log;
+  FieldTrials trials = SetFieldTrial("TiPlay-SourceRateVideo", "Enabled");
+  ConfigureEncoder(video_encoder_config_.Copy(),
+      VideoStreamEncoder::BitrateAllocationCallbackType::kVideoBitrateAllocationWhenScreenSharing,
+      1, &trials);
+  video_stream_encoder_->SetSourceRateSending(true, true, 71, 89);
+  video_stream_encoder_->WaitUntilTaskQueueIsIdle();
+  video_source_.IncomingCapturedFrame(CreateFrame(1, codec_width_, codec_height_));
+  WaitForEncodedFrame(1);
+  video_stream_encoder_->SetSourceRateSending(false, true, 71, 89);
+  video_stream_encoder_->WaitUntilTaskQueueIsIdle();
+  video_source_.IncomingCapturedFrame(CreateFrame(34, codec_width_, codec_height_));
+  EXPECT_FALSE(WaitForFrame(TimeDelta::Millis(100)));
+  video_stream_encoder_->SetSourceRateSending(true, true, 71, 89);
+  video_stream_encoder_->WaitUntilTaskQueueIsIdle();
+  video_source_.IncomingCapturedFrame(CreateFrame(200, codec_width_, codec_height_));
+  WaitForEncodedFrame(200);
+  EXPECT_EQ(log.Count("encoder_gate"), 2);
+  EXPECT_EQ(log.Count("\"network\":0,\"stream\":1,\"allow\":0"), 1);
+  EXPECT_EQ(log.Count("\"network\":1,\"stream\":1,\"allow\":1"), 1);
+  video_stream_encoder_->Stop();
+}
+
+TEST_F(VideoStreamEncoderTest, SourceRateDiagnosticGateDoesNotMarkAdaptiveEncoder) {
+  SourceRateDiagnosticLogSink log;
+  video_stream_encoder_->SetSourceRateSending(true, true, 71, 89);
+  video_stream_encoder_->OnBitrateUpdatedAndWaitForManagedResources(kTargetBitrate, kTargetBitrate, 0, 0, 0);
+  video_source_.IncomingCapturedFrame(CreateFrame(1, codec_width_, codec_height_));
+  WaitForEncodedFrame(1);
+  EXPECT_EQ(log.Count("encoder_gate"), 0);
+  video_stream_encoder_->Stop();
+}
