+void VideoStreamEncoder::SetSourceRateSending(
+    bool network_available, bool stream_active, uint64_t transport_id,
+    uint32_t ssrc) {
+  if (!env_.field_trials().IsEnabled("TiPlay-SourceRateVideo")) return;
+  if (!encoder_queue_->IsCurrent()) {
+    encoder_queue_->PostTask([this, network_available, stream_active, transport_id, ssrc] {
+      SetSourceRateSending(network_available, stream_active, transport_id, ssrc);
+    });
+    return;
