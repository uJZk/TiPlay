+class SourceRateDiagnosticLogSink final : public LogSink {
+ public:
+  SourceRateDiagnosticLogSink() { LogMessage::AddLogToStream(this, LS_INFO); }
+  ~SourceRateDiagnosticLogSink() override { LogMessage::RemoveLogToStream(this); }
+  void OnLogMessage(const std::string& message) override {
+    if (message.find("TIPLAY_RTC_SOURCE_RATE ") == std::string::npos) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    messages_.push_back(message);
+  }
+  int Count(const std::string& token) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    int count = 0;
+    for (const auto& message : messages_)
+      if (message.find(token) != std::string::npos) ++count;
+    return count;
+  }
+ private:
+  std::mutex mutex_;
+  std::vector<std::string> messages_;
+};
