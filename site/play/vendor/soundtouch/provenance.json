{
  "library": "SoundTouch",
  "version": "2.4.0",
  "license": "LGPL-2.1-or-later",
  "source_url": "https://www.surina.net/soundtouch/soundtouch-2.4.0.tar.gz",
  "source_archive": "source/soundtouch-2.4.0.tar.gz",
  "source_sha256": "3dda3c9ab1e287f15028c010a66ab7145fa855dfa62763538f341e70b4d10abd",
  "source_modifications": "none; browser ABI is a separate GPL-3.0-only source file",
  "build": "scripts/soundtouch/build.py",
  "toolchain": "WASI SDK 34.0 / clang 23",
  "runtime": "standalone WebAssembly reactor, separate memory per processor",
  "settings": {
    "sample_format": "float32 stereo",
    "quick_seek": true,
    "rate_and_pitch": 1,
    "rate_antialias_filter": false,
    "sequence_ms": "round(130 - 20 * tempo), tempo 0.25 to 4",
    "seek_window_ms": "round(25 + (0.25 - tempo) * 10 / 3.75)",
    "initial_memory_bytes": 4194304,
    "maximum_memory_bytes": 16777216,
    "native_input": "quad/5.1 original planes, fused speaker mapping plus interleave; mono/stereo retain direct JavaScript layout stores by measured policy",
    "input_scratch_bytes": 98304,
    "downmix_arithmetic": "double expression rounded once to float32, matching the established Web Audio speaker mapping",
    "live": {
      "channels": "mono/stereo",
      "tempo_range": [
        0.95,
        1.2
      ],
      "sequence_ms": 20,
      "seek_ms": 5,
      "overlap_ms": 5,
      "clock_conversion": "libsoxr, independent from tempo"
    }
  },
  "binaries": {
    "soundtouch.wasm": {
      "bytes": 56193,
      "sha256": "78ad63ce238133414be5806d537dd369920120844fa782940c034ca0cf7a1fd5",
      "automatic_playback": "live CarPlay on non-SIMD browsers"
    },
    "soundtouch.simd.wasm": {
      "bytes": 59356,
      "sha256": "c402252ea779248fd13114fc1d6763be91f0b770996e8087cc7e307dc5f2bb70",
      "automatic_playback": "live CarPlay and non-1x SIMD URL audio"
    }
  }
}
